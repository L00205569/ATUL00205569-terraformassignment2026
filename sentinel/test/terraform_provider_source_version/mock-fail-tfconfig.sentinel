providers = {
  "aws" : {
    "full_name"          : "registry.terraform.io/hashicorp/aws",
    "version_constraint" : "~> 6.0",
    "config" : {},
  },
}
module_calls = {
  "network" : {
    "source" : "git::https://github.com/someone/aws-modules.git//vpc?ref=main",
  },
  "compute" : {
    "source" : "./modules/compute",
  },
  "storage" : {
    "source" : "./modules/storage",
  },
}
